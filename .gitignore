# Miscellaneous
*.class
*.log
# ENH-57: these are intentionally checked in (device smoke-test evidence),
# not accidentally-ignored — un-ignoring them here so `dart pub publish
# --dry-run` stops flagging a checked-in/gitignore-status mismatch. They're
# still excluded from the actual published archive via .pubignore's doc/
# rule.
!doc/task/evidence/*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.codebase-memory/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing (contains secrets — do not track). See example/android/app.properties.example
# for the setup a fresh clone needs (keystore alias/password + external keystore path).
/example/android/gradle.properties
/example/android/app.properties
/example/android/keystore.jks

# Machine-local SDK path, not shared across dev machines
**/local.properties

# Build output
/example/build/
